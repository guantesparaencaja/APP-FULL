rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'teacher']) ||
         (request.auth.token.email == "guantesparaencajar@gmail.com" && request.auth.token.email_verified == true) ||
         (request.auth.token.email == "hernandezkevin001998@gmail.com" && request.auth.token.email_verified == true));
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ===============================================================
    // Rules for Collections
    // ===============================================================

    // Usuarios
    match /users/{uid} {
      allow read, update: if isOwner(uid) || isAdmin();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Entrenos / Videos de entrenamiento
    match /workout_videos/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /workout_categories/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Clases y reservas
    match /clases/{fecha}/reservas/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /bookings/{id} {
      allow read: if isAuthenticated();
      allow create: if isOwner(request.resource.data.user_id) || isAdmin();
      // El usuario solo puede CANCELAR su propia reserva; el resto solo admin
      allow update: if isAdmin() ||
        (isOwner(request.resource.data.user_id) &&
         resource.data.user_id == request.auth.uid &&
         resource.data.status == 'active' &&
         request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    // Horarios disponibles (Admin los crea/edita/borra, todos los leen)
    match /availabilities/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Excepciones de disponibilidad (Admin las gestiona)
    match /availability_exceptions/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Pagos — el usuario registra su propio pago, pero SOLO admin lo aprueba/modifica
    match /payments/{id} {
      allow read: if isOwner(resource.data.user_id) || isAdmin();
      allow create: if isOwner(request.resource.data.user_id) && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Planes
    match /planes/{id} {
      allow read: if isAuthenticated();
      allow write, delete: if isAdmin();
    }

    // Notificaciones
    match /notifications/{id} {
      allow read: if isOwner(resource.data.user_id) || resource.data.user_id == 'admin' || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.user_id) || isAdmin();
      allow delete: if isAdmin();
    }

    // Correos de la extensión Trigger Email
    match /mail/{id} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Default rules — SOLO admin escribe; autenticados solo leen
    match /{path=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}